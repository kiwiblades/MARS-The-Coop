# Backend server port
SV_PORT=5000

# Postgres database keys
PGUSER="postgres"
PGPASSWORD="postgres"
PGDATABASE="the_coop"
# If there are any issues with database setup, try changing the port number to 5433 or similar, or check for pg services running
PGPORT="5433"
PGHOST="127.0.0.1"

# If you adjust any database values, you MUST make sure DATABASE_URL reflects these changes, or else db setup won't work
# postgres://{PGUSER}:{PGPASSWORD}@{PGHOST}:{PGPORT}/{PGDATABASE}?schema=public
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5433/the_coop?schema=public"

# Email service info
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="businessemail@gmail.com"
SMTP_PASS="your-smtp-password"
SMTP_SECURE=true
EMAIL_FROM="NAME Support <businessemail@gmail.com>"

# JWT
# To generate the token keys, you can run this command and copy the output:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
VERIFY_EMAIL_SECRET=
TOKEN_HASH_SECRET=
# Expiry settings
ACCESS_EXPIRES_IN="15m"
REFRESH_EXPIRES_IN="30d"
VERIFY_EMAIL_EXPIRES_IN="1d"

# Google Sheets sync
SHEETS_KEY_FILE_PATH="../sheet-service.json" # additional settings json, must be dropped in proj root + untracked
SHEETS_SPREADSHEET_ID="" # id of the questions spreadsheet
SHEETS_SHEET_NAME="" # name of the sheet tab within the sheet
SHEETS_SYNC_INTERVAL_HOURS=1 # how often the sync runs

# Daily questions cron
DAILYQ_CRON_TIME="0 5 * * *" # when the daily questions are sent by default
# FORMAT: 1 2 3 4 5 => 1: minute (0-59), 2: hour (0-23), 3: day of month (1-31), 4: month (1-12), 5: day of week (0-7)
# for more info: https://crontab.guru/#
DAILYQ_TIMEZONE="America/Chicago" # default timezone
# for more info: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones